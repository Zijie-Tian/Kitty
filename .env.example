# Copy this file to `.env` and fill in local paths for this checkout.
# `.env` is intentionally git-ignored; do not commit host-specific paths.
#
# Values use bash syntax because repository scripts source this file.

# Python/runtime
KITTY_PYTHON_BIN=python
KITTY_CONDA_ENV=kitty

# Local model/data paths. Leave model fields empty to use the runner's
# Llama-3.2-1B defaults, or set MODEL/MODEL_PATH/MODEL_TAG/MODEL_FAMILY for a
# different checkpoint.
MODEL=
MODEL_PATH=
MODEL_TAG=
MODEL_FAMILY=
KITTY_LLAMA31_8B_PATH=
KITTY_LLAMA32_1B_PATH=
KITTY_MINICPM5_1B_PATH=
KITTY_QWEN3_8B_PATH=
LONGBENCH_DATA_ROOT=

# RULER data is intentionally separate from LongBench outputs.
# RULER_DATA_ROOT contains <length>/<task>/validation.{jsonl,manifest.json};
# RULER_SOURCE_ROOT contains the local essay/QA files used by preparation.
RULER_DATA_ROOT=
RULER_SOURCE_ROOT=

# Optional offline calibration inputs/artifacts for canonical qlutattn. Keep
# real host paths in `.env` only. Set QLUT_CB_MASK to the mask for the model in
# the current run; the model-specific variables are convenient path storage.
KITTY_WIKITEXT2_TRAIN_PATH=
KITTY_LLAMA32_1B_QLUTATTN_MASK=
KITTY_MINICPM5_1B_QLUTATTN_MASK=
QLUT_CB_MASK=

# GPU1-only evaluation defaults.
GPU_IDS_CSV=1
GPU_ID=1

# Optional common evaluation defaults.
LOCAL_FILES_ONLY=1
