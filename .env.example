# Copy this file to `.env` and fill in local paths for this checkout.
# `.env` is intentionally git-ignored; do not commit host-specific paths.
#
# Values use bash syntax because repository scripts source this file.

# Python/runtime
KITTY_PYTHON_BIN=python
KITTY_CONDA_ENV=kitty

# Local model/data paths. Leave empty if you want Hugging Face IDs or explicit
# command-line environment variables to resolve the model/data instead.
KITTY_LLAMA31_8B_PATH=
KITTY_LLAMA32_1B_PATH=
KITTY_QWEN3_8B_PATH=
LONGBENCH_DATA_ROOT=

# Optional offline calibration inputs/artifacts for the Llama-3.2-1B SNF
# (sign/nf2) variants. Keep the real host paths in `.env` only.
KITTY_WIKITEXT2_TRAIN_PATH=
KITTY_LLAMA32_1B_SNF_MASK=

# GPU1-only evaluation defaults.
GPU_IDS_CSV=1
GPU_ID=1

# Optional common evaluation defaults.
LOCAL_FILES_ONLY=1
